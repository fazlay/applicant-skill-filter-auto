<!-- views/account_move_views.xml -->
<odoo>
    <data>
        <!-- Add Recalculate button to invoice form -->
        <record id="view_move_form_custom_calc" model="ir.ui.view">
            <field name="name">account.move.form.custom.calc</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//button[@name='action_post']" position="after">
                    <button name="action_recalculate_custom_lines"
                            type="object"
                            string="Recalculate Custom Lines"
                            class="oe_highlight"
                            invisible="not invoice_line_ids"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>