<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_invoice_document_inherit_custom" inherit_id="account.report_invoice_document">

        <xpath expr="//td[@name='td_subtotal']" position="replace">
            <td name="td_subtotal" class="text-end o_price_total">
                <span class="text-nowrap" t-if="line.display_subtotal_from_line" t-out="line.display_subtotal_from_line.price_subtotal" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                <span class="text-nowrap" t-else="" t-out="line.price_subtotal" t-options="{
                      'widget': 'monetary',
                      'display_currency': line.product_id.display_currency_id or o.currency_id
                  }"/>
            </td>
        </xpath>

    </template>
