    <template id="report_invoice_document_inherit_custom" inherit_id="account.report_invoice_document">
        <xpath expr="//td[@name='td_subtotal']" position="replace">
            <td name="td_subtotal" class="text-end o_price_total">
                <span class="text-nowrap" t-out="line.price_subtotal" t-options="{
                      'widget': 'monetary',
                      'display_currency': line.product_id.display_currency_id or o.currency_id
                  }">
                </span>
            </td>
        </xpath>
    </template>
    <template id="your_custom_tax_totals" inherit_id="account.document_tax_totals_template">
        <xpath expr="//tr[hasclass('o_total')]" position="replace">
            <tr class="o_total">
                <td>
                    <strong>Total Amount</strong>
                </td>
                <td class="text-end">
                    <t t-if="o.use_custom_total">
                        <t t-set="bdt_currency" t-value="env['res.currency'].search([('name', '=', 'BDT')], limit=1)"/>
                        <strong t-out="o.custom_total" t-options='{"widget": "monetary", "display_currency": bdt_currency}'/>
                    </t>
                    <t t-else="">
                        <strong t-out="tax_totals['total_amount_currency']" t-options='{"widget": "monetary", "display_currency": currency}'/>
                    </t>
                </td>
            </tr>

        </xpath>
    </template>
</odoo>