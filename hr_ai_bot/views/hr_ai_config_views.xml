<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="action_hr_ai_config" model="ir.actions.act_window">
        <field name="name">AI Provider Config</field>
        <field name="res_model">hr.ai.config</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
    </record>

    <menuitem id="menu_hr_ai_config" name="Provider Config" parent="menu_hr_ai_root" action="action_hr_ai_config" sequence="100"/>

    <record id="view_hr_ai_config_form" model="ir.ui.view">
        <field name="name">hr.ai.config.form</field>
        <field name="model">hr.ai.config</field>
        <field name="arch" type="xml">
            <form string="HR AI Configuration">
                <sheet>
                    <group string="LLM (Chat) Provider">
                        <group>
                            <field name="llm_provider"/>
                            <field name="llm_model"/>
                            <field name="llm_api_key" password="True" attrs="{'invisible': [('llm_provider', '=', 'ollama')]}"/>
                            <field name="llm_temperature"/>
                            <field name="llm_max_tokens"/>
                        </group>
                    </group>

                    <group string="Embedding Provider">
                        <group>
                            <field name="embedding_provider"/>
                            <field name="embedding_model"/>
                            <field name="embedding_api_key" password="True" attrs="{'invisible': [('embedding_provider', '=', 'ollama')]}"/>
                            <field name="embedding_dimension"/>
                        </group>
                    </group>

                    <group string="Ollama Settings" attrs="{'invisible': [('llm_provider', '!=', 'ollama')]}">
                        <field name="ollama_base_url"/>
                        <div class="alert alert-info">
                            <p>To use Ollama:</p>
                            <ol>
                                <li>Install Ollama from <a href="https://ollama.ai" target="_blank">https://ollama.ai</a></li>
                                <li>Pull models: <code>ollama pull llama3.2</code> and <code>ollama pull nomic-embed-text</code></li>
                                <li>Start Ollama: <code>ollama serve</code></li>
                                <li>Default URL is http://localhost:11434</li>
                            </ol>
                        </div>
                    </group>

                    <group string="RAG Parameters">
                        <group>
                            <field name="chunk_size"/>
                            <field name="chunk_overlap"/>
                            <field name="top_k"/>
                        </group>
                    </group>

                    <group string="Advanced">
                        <group>
                            <field name="request_timeout"/>
                            <field name="system_prompt" colspan="2"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
