<odoo>
    <template id="my_custom_portal_content" inherit_id="website_hr_recruitment.apply">
        <xpath expr="//textarea[@id='recruitment5']/ancestor::div[contains(@class, 's_website_form_field')]" position="inside">




            <div class="col-12 mb-0 py-2 s_website_form_field s_website_form_required" data-type="char" data-name="Field">
                <div class="row s_col_no_resize s_col_no_bgcolor">
                    <label class="col-4 col-sm-auto s_website_form_label" style="width: 200px" for="recruitment3">
                        <span class="s_website_form_label_content">Enter your skills Here</span>
                        <span class="s_website_form_mark"> *</span>
                    </label>
                    <div class="col-sm">
                        <select name="skill_ids" t-attf-class="form-control  select_box_test" required="" multiple="">

                            <t t-foreach="skills" t-as="skill">
                                <option t-att-value="skill.id">
                                    <t t-esc="skill.name"/>
                                </option>
                            </t>
                        </select>
                    </div>
                </div>
            </div>

        </xpath>

    </template>

</odoo>


